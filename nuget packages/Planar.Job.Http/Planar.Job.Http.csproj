<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
		<Version>1.8.2.0</Version>
		<RepositoryType>git</RepositoryType>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
		<Description>Library for writing .NET jobs for Planar, Triggered by RabbitMQ queue</Description>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<PackageIcon>nuget_logo.png</PackageIcon>
		<Title>Library for writing .NET jobs for Planar, Triggered by RabbitMQ queue</Title>
		<PackageProjectUrl>https://github.com/atias007/Planar</PackageProjectUrl>
		<RepositoryUrl>https://github.com/atias007/Planar</RepositoryUrl>
		<PackageTags>planar;job;schedule;task;automation</PackageTags>
		<IncludeSymbols>False</IncludeSymbols>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<NoWarn>1701;1702;NU1803</NoWarn>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<NoWarn>1701;1702;NU1803</NoWarn>
	</PropertyGroup>
	<ItemGroup>
		<None Include="..\..\res\nuget_logo.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>
	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>
	<ItemGroup>
		<None Include="..\..\res\nuget_logo.png" Link="nuget_logo.png" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
		<PackageReference Include="CloudNative.CloudEvents" Version="2.9.0" />
		<PackageReference Include="CloudNative.CloudEvents.NewtonsoftJson" Version="2.9.0" />
		<PackageReference Include="MQTTnet.Extensions.ManagedClient" Version="4.3.7.1207" />
		<PackageReference Include="NetEscapades.Configuration.Yaml" Version="3.1.0" />
		<PackageReference Include="SonarAnalyzer.CSharp" Version="10.35.0.4138">
		  <PrivateAssets>all</PrivateAssets>
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>

		<PackageReference Include="YamlDotNet" Version="18.1.0" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\Planar.Common\Planar.Common.csproj" />
	</ItemGroup>
	<ItemGroup>
		<Folder Include="Logger\" />
		<Folder Include="JobExecutionContext\" />
	</ItemGroup>
	<ItemGroup>
		<Compile Include="..\Planar.Common\ConsoleLogger.cs" Link="ConsoleLogger.cs" />
		<Compile Include="..\Planar.Common\JobInstanceInfo.cs" Link="JobInstanceInfo.cs" />
		<Compile Include="..\Planar.Job.RabbitMQ\AesGcmStringCipher.cs" Link="AesGcmStringCipher.cs" />
		<Compile Include="..\Planar.Job.RabbitMQ\BaseHostedJobStartPropertiesBuilder.cs" Link="BaseHostedJobStartPropertiesBuilder.cs" />
		<Compile Include="..\Planar.Job.RabbitMQ\ManifestUtil.cs" Link="ManifestUtil.cs" />
		<Compile Include="..\Planar.Job.RabbitMQ\PlanarHostedJobCommon.cs" Link="PlanarHostedJobCommon.cs" />
		<Compile Include="..\Planar.Common\PlanarConvert.cs" Link="PlanarConvert.cs" />
		<Compile Include="..\Planar.Job\ReflectionHelper.cs" Link="ReflectionHelper.cs" />
		<Compile Include="..\Planar.Job\YmlUtil.cs" Link="YmlUtil.cs" />
	</ItemGroup>
</Project>
