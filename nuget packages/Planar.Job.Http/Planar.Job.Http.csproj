<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
		<Version>1.8.2.0</Version>
		<RepositoryType>git</RepositoryType>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
		<Description>Library for writing .NET jobs for Planar, Triggered by RabbitMQ queue</Description>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<PackageIcon>nuget_logo.png</PackageIcon>
		<Title>Library for writing .NET jobs for Planar, Triggered by RabbitMQ queue</Title>
		<PackageProjectUrl>https://github.com/atias007/Planar</PackageProjectUrl>
		<RepositoryUrl>https://github.com/atias007/Planar</RepositoryUrl>
		<PackageTags>planar;job;schedule;task;automation</PackageTags>
		<IncludeSymbols>False</IncludeSymbols>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<NoWarn>1701;1702;NU1803</NoWarn>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<NoWarn>1701;1702;NU1803</NoWarn>
	</PropertyGroup>
	<ItemGroup>
	  <Compile Remove="JobExecutionContext\**" />
	  <Compile Remove="Logger\**" />
	  <EmbeddedResource Remove="JobExecutionContext\**" />
	  <EmbeddedResource Remove="Logger\**" />
	  <None Remove="JobExecutionContext\**" />
	  <None Remove="Logger\**" />
	</ItemGroup>
	<ItemGroup>
		<None Include="..\..\res\nuget_logo.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>
	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>
	<ItemGroup>
		<None Include="..\..\res\nuget_logo.png" Link="nuget_logo.png" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="SonarAnalyzer.CSharp" Version="10.35.0.4138">
		  <PrivateAssets>all</PrivateAssets>
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\Planar.Common\Planar.Common.csproj" />
	</ItemGroup>
</Project>
