<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>netstandard2.0;netstandard2.1</TargetFrameworks>
		<Version>1.8.2.0</Version>
		<RepositoryType>git</RepositoryType>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
		<Description>Library for writing DotNet jobs for Planar</Description>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<Title>Library for writing DotNet jobs for Planar</Title>
		<PackageProjectUrl>https://github.com/atias007/Planar</PackageProjectUrl>
		<PackageIcon>nuget_logo.png</PackageIcon>
		<RepositoryUrl>https://github.com/atias007/Planar</RepositoryUrl>
		<PackageTags>planar;job;schedule;task;automation</PackageTags>
		<IncludeSymbols>False</IncludeSymbols>
	</PropertyGroup>
	<PropertyGroup Condition=" '$(TargetFramework)' != 'netstandard2.0'">
		<Nullable>enable</Nullable>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<NoWarn>1701;1702;NU1803</NoWarn>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<NoWarn>1701;1702;NU1803</NoWarn>
	</PropertyGroup>

	<ItemGroup>
	  <Compile Remove="JobExecutionContext\**" />
	  <Compile Remove="Properties\**" />
	  <EmbeddedResource Remove="JobExecutionContext\**" />
	  <EmbeddedResource Remove="Properties\**" />
	  <None Remove="JobExecutionContext\**" />
	  <None Remove="Properties\**" />
	</ItemGroup>
	<ItemGroup>
	  <None Include="..\..\res\nuget_logo.png">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	</ItemGroup>
	<ItemGroup Condition=" '$(TargetFramework)' == 'netstandard2.1'">
		<PackageReference Include="System.Text.Json" Version="10.0.14" />
	</ItemGroup>
	<ItemGroup>
	  <PackageReference Include="SonarAnalyzer.CSharp" Version="10.35.0.4138">
	    <PrivateAssets>all</PrivateAssets>
	    <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
	  </PackageReference>
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\Planar.Common\Planar.Common.csproj" />
	</ItemGroup>

</Project>